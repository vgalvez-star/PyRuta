{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Banco de preguntas PyRuta",
  "type": "object",
  "required": ["bank", "version", "language", "exam", "sections", "questions"],
  "properties": {
    "bank": {"type": "string"},
    "version": {"type": "string", "description": "Versión semántica del banco (MAYOR.MENOR.PARCHE)."},
    "language": {"type": "string"},
    "exam": {"type": "string"},
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "weight"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "weight": {"type": "number", "description": "Peso aproximado de la sección en el examen, en %."}
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "exam", "section", "difficulty", "type", "prompt", "options", "answer", "explanation"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z]+-[A-Z]{3}-[0-9]{3}$"},
          "exam": {"type": "string"},
          "section": {"type": "string"},
          "difficulty": {"type": "integer", "minimum": 1, "maximum": 3},
          "type": {"enum": ["single", "multiple"]},
          "prompt": {"type": "string"},
          "code": {"type": "string"},
          "options": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "answer": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
          "explanation": {"type": "string"},
          "verify": {"enum": ["output"], "description": "El validador ejecuta 'code' y exige que la opción correcta sea su salida."}
        }
      }
    }
  }
}
